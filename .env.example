# =============================================================================
# Devina Store — contoh variabel lingkungan
# Salin file ini menjadi `.env.local` lalu isi nilainya:
#   cp .env.example .env.local
# JANGAN commit `.env.local` atau file .env lain yang berisi kunci asli.
# Variabel berawalan NEXT_PUBLIC_ terlihat oleh browser — jangan isi rahasia di sana.
# =============================================================================

# --- Situs (dipakai sejak Phase 2) -------------------------------------------
# Alamat lengkap situs, tanpa garis miring di akhir. Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 3) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=ganti-dengan-publishable-key
# RAHASIA — hanya untuk server. Jangan pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key
# Email admin yang diizinkan (pisahkan dengan koma). Pemeriksaan kedua selain tabel admin_users.
ADMIN_EMAILS=email-pemilik@contoh.com

# --- Midtrans (Phase 7) -------------------------------------------------------
# false = sandbox. Ubah ke true HANYA setelah akun produksi terverifikasi.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=ganti-dengan-merchant-id
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
# RAHASIA — hanya untuk server.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx

# --- Biteship (Phase 6) -------------------------------------------------------
# RAHASIA — hanya untuk server.
BITESHIP_API_KEY=ganti-dengan-api-key-biteship

# --- Tugas terjadwal (Phase 7–8) ---------------------------------------------
# String acak panjang untuk melindungi endpoint /api/cron/*
CRON_SECRET=ganti-dengan-string-acak-panjang
